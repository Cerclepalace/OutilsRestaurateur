# =============================================================================
# BOBO PARIS — environment
# Copy to .env.local and fill in. Never commit .env.local.
# =============================================================================

# --- Supabase (Project settings > API) ---------------------------------------
# Safe to expose to the browser: protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server only. Bypasses RLS — never prefix with NEXT_PUBLIC_.
# Required by: the Stripe webhook and `npm run seed`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (Developers > API keys) ------------------------------------------
# Server only.
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret of the webhook endpoint pointed at /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Browser key used by Stripe.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Site --------------------------------------------------------------------
# Absolute origin, used for canonical URLs, sitemap, and Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
